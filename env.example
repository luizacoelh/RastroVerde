# Copie para .env (nunca commite o .env).

# Supabase > Project Settings > Database > Connection string
# Pooler em modo "Transaction" (porta 6543) — usado pela aplicação (Vercel/serverless).
# sslmode=require + uselibpqcompat: conexão criptografada (mesma semântica do libpq).
DATABASE_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true"
# Conexão direta / "Session" (porta 5432) — usada pelo Prisma Migrate.
DIRECT_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Auth.js — gere com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=""
