# Copie para .env (nunca commite o .env).

# Supabase > Project Settings > Database > Connection string
# Pooler em modo "Transaction" (porta 6543) — usado pela aplicação (Vercel/serverless).
# sslmode=require + uselibpqcompat: conexão criptografada (mesma semântica do libpq).
DATABASE_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-1-us-west-2.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true"
# Pooler em modo "Session" (porta 5432) — usado pelo Prisma Migrate.
# (A conexão direta db.<ref>.supabase.co também serve, mas no plano gratuito é só IPv6.)
DIRECT_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

# Auth.js — gere com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=""

# Endereço público do app, usado no QR code do dossiê (/verificar/{codigo}).
# Em produção: a URL da Vercel. Vazio → usa o endereço da requisição (bom para desenvolvimento).
APP_URL=""

# Google Gemini (opcional) — resumo do dossiê em linguagem simples (US11).
# Crie a chave em https://aistudio.google.com/apikey. Sem chave, o dossiê usa o texto padrão (RNF10).
GEMINI_API_KEY=""
# Modelo (opcional); padrão: gemini-flash-latest
GEMINI_MODEL=""
