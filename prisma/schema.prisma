// Modelo de dados do RastroVerde — ver docs/04-arquitetura.md §4.5.
// Geometrias em GeoJSON (WGS 84 / EPSG:4326) guardadas como JSONB.
// O retângulo envolvente (bbox) fica em 4 colunas numéricas indexadas para o filtro
// prévio da análise (ADR-01).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Risco {
  BAIXO
  ATENCAO
  ALTO
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  criadoEm  DateTime @default(now())

  propriedades Propriedade[]

  @@map("usuario")
}

model Propriedade {
  id        String   @id @default(cuid())
  usuarioId String
  nome      String
  municipio String
  uf        String   @db.Char(2)
  cultura   String
  car       String?
  criadoEm  DateTime @default(now())
  alteradoEm DateTime @updatedAt

  usuario Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  talhoes Talhao[]

  @@index([usuarioId])
  @@map("propriedade")
}

model Talhao {
  id            String   @id @default(cuid())
  propriedadeId String
  nome          String
  /// GeoJSON Geometry (Polygon ou MultiPolygon)
  geometria     Json
  areaHa        Float
  bboxMinLng    Float
  bboxMinLat    Float
  bboxMaxLng    Float
  bboxMaxLat    Float
  criadoEm      DateTime @default(now())
  alteradoEm    DateTime @updatedAt

  propriedade Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  analises    Analise[]

  @@index([propriedadeId])
  @@map("talhao")
}

model BaseAlertas {
  id          String   @id @default(cuid())
  fonte       String
  versao      String
  importadaEm DateTime @default(now())
  /// Área coberta pelo recorte (GeoJSON Polygon/MultiPolygon, ex.: limites dos municípios).
  /// Talhão fora dela → "região sem dados" (UC4).
  cobertura   Json
  /// Texto para o usuário, ex.: "Luís Eduardo Magalhães e São Desidério (BA)" — usado na mensagem de
  /// "região sem dados" e na legenda do mapa. É só descrição: não entra na análise.
  descricaoCobertura String?
  bboxMinLng  Float
  bboxMinLat  Float
  bboxMaxLng  Float
  bboxMaxLat  Float

  alertas  Alerta[]
  analises Analise[]

  @@unique([fonte, versao])
  @@map("base_alertas")
}

model Alerta {
  id           String   @id @default(cuid())
  baseId       String
  /// Identificador do alerta na fonte original (ex.: uuid do PRODES, código do MapBiomas)
  codigoFonte  String?
  /// GeoJSON Geometry (Polygon ou MultiPolygon)
  geometria    Json
  dataDeteccao DateTime @db.Date
  bboxMinLng   Float
  bboxMinLat   Float
  bboxMaxLng   Float
  bboxMaxLat   Float

  base BaseAlertas @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@index([baseId, dataDeteccao])
  @@index([bboxMinLng, bboxMaxLng, bboxMinLat, bboxMaxLat])
  @@map("alerta")
}

model Analise {
  id                String   @id @default(cuid())
  talhaoId          String
  baseId            String
  areaSobrepostaHa  Float
  percentual        Float
  risco             Risco
  /// GeoJSON FeatureCollection com as áreas sobrepostas
  sobreposicao      Json
  /// RN03: true quando o polígono do talhão foi editado depois desta análise
  obsoleta          Boolean  @default(false)
  criadaEm          DateTime @default(now())

  talhao Talhao      @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  base   BaseAlertas @relation(fields: [baseId], references: [id], onDelete: Restrict)
  dossie Dossie?

  @@index([talhaoId, criadaEm])
  @@map("analise")
}

/// Dossiê emitido (US10). Imutável (RN04): guarda o PDF e uma cópia dos dados usados nele, para a
/// página de verificação não depender de propriedade/talhão, que podem ser editados depois.
model Dossie {
  id          String   @id @default(cuid())
  analiseId   String   @unique
  /// Código público (ex.: RV-2026-8F3K2Q), usado em /verificar/{codigo}
  codigo      String   @unique
  /// SHA-256 (hex) dos bytes do PDF (RF17)
  hash        String
  /// Resumo em linguagem simples (RF16): da IA ou o texto padrão
  resumo      String
  resumoPorIA Boolean
  /// Dados do dossiê no momento da emissão (propriedade, talhão, análise, base)
  conteudo    Json
  pdf         Bytes
  emitidoEm   DateTime @default(now())

  /// Restrict: um dossiê emitido impede excluir a análise e, em cascata, o talhão (RN04).
  analise Analise @relation(fields: [analiseId], references: [id], onDelete: Restrict)

  @@map("dossie")
}

/// Limites oficiais dos municípios (malha do IBGE), usados para conferir se o talhão está no
/// município declarado na propriedade (defeito 8). Dado de referência, importado por script.
model Municipio {
  /// Código IBGE de 7 dígitos (ex.: 2919553)
  codigoIbge String @id @db.Char(7)
  nome       String
  uf         String @db.Char(2)
  /// GeoJSON Polygon/MultiPolygon do limite municipal
  geometria  Json
  bboxMinLng Float
  bboxMinLat Float
  bboxMaxLng Float
  bboxMaxLat Float

  @@index([bboxMinLng, bboxMaxLng, bboxMinLat, bboxMaxLat])
  @@map("municipio")
}
